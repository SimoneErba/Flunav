<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>flunav.simulator</groupId>
  <artifactId>apisimulator</artifactId>
  <version>1.0-SNAPSHOT</version>

  <name>apisimulator</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Aggiorniamo a una versione di Java più moderna, es. 17 o 21 -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>
    <!-- ... (le tue dipendenze rimangono le stesse) ... -->
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
      <version>5.20.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.17.1</version>
    </dependency>
    <dependency>
      <groupId>flunav</groupId>
      <artifactId>events</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Plugin per creare un "fat JAR" che include tutte le dipendenze -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <!-- Specifica la classe Main da eseguire -->
                  <mainClass>flunav.simulator.App</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Plugin Jib per creare l'immagine Docker -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <version>3.4.0</version> <!-- Usa una versione recente -->
        <configuration>
          <from>
            <!-- Usiamo un'immagine base leggera che contiene solo la Java Runtime -->
            <image>eclipse-temurin:17-jre-alpine</image>
          </from>
          <to>
            <!-- Nome dell'immagine che verrà creata -->
            <image>ghcr.io/simoneerba/flunav-simulator:latest</image>
          </to>
          <container>
            <!-- Non esponiamo porte, il simulatore fa solo chiamate in uscita -->
            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
            <!-- Il comando di default per avviare il container -->
            <mainClass>flunav.simulator.App</mainClass>
            <!-- Gli argomenti di default, possono essere sovrascritti -->
            <args>
              <arg>multi</arg>
            </args>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>