{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["@playwright/test"]
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts", "e2e/**/*.d.ts", "src/vite-env.d.ts"]
}
